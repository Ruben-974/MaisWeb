# Acervo, referências e arquivos gerados: ficam somente no computador.
/arquivos/mapeamento site/
/arquivos/referencias/
/arquivos/assets-nao-utilizados/
/arquivos/output/
/arquivos/tmp/
/arquivos/relatorios/
/mapeamento site/
/output/
/tmp/

# Cópias locais de imagens, vídeos e documentos do site.
/assets/img/**
/assets/media/
/assets/documents/

# Mídias e documentos adicionados em outras pastas.
*.png
*.jpg
*.jpeg
*.webp
*.avif
*.gif
*.bmp
*.ico
*.svg
*.tif
*.tiff
*.heic
*.psd
*.mp4
*.webm
*.mov
*.m4v
*.avi
*.mkv
*.wmv
*.mp3
*.wav
*.ogg
*.m4a
*.flac
*.pdf
*.doc
*.docx
*.odt
*.xls
*.xlsx
*.ppt
*.pptx
*.epub
*.zip
*.rar
*.7z
*.tar
*.gz
*.tgz

# Exceções essenciais: sem URL pública; aproximadamente 220 KB no total.
!/assets/img/banner.webp
!/assets/img/favicon.png

# Dependências, caches e arquivos de ambiente.
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
desktop.ini
